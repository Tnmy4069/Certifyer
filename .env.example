# MongoDB connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/?appName=APP

# Auth.js / NextAuth
AUTH_SECRET=generate-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# App
APP_URL=http://localhost:3000
NODE_ENV=development

# Local storage root (private files)
STORAGE_ROOT=./storage

# Super admin (created/updated by npm run seed)
SUPER_ADMIN_EMAIL=admin@certify.local
SUPER_ADMIN_PASSWORD=Admin123!
SUPER_ADMIN_NAME=Certify Super Admin
