# MongoDB connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/?appName=APP

# Auth.js / NextAuth secret (required: at least 16 chars)
AUTH_SECRET=generate-a-long-random-secret

# Domain / URLs (Optional: multi-domain is supported automatically by default)
# Leave these commented out or omitted to let Certify dynamically detect the active domain from incoming requests.
# NEXTAUTH_URL=https://yourdomain.com
# APP_URL=https://yourdomain.com

NODE_ENV=development

# Local storage root (private files)
STORAGE_ROOT=./storage

# Super admin (created/updated by npm run seed)
SUPER_ADMIN_EMAIL=admin@certify.local
SUPER_ADMIN_PASSWORD=Admin123!
SUPER_ADMIN_NAME=Certify Super Admin
